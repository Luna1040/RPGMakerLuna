extends SceneTree

func _initialize() -> void:
 var g=load("res://canosa.gd").new()
 g.new_run()
 var p:=Vector2(820,1700)
 assert(g.world_pos(g.screen_pos(p)).distance_to(p)<0.01)
 var event:=InputEventMouseButton.new()
 event.button_index=MOUSE_BUTTON_LEFT
 event.pressed=true
 event.position=g.screen_pos(g.npcs[0].pos)+Vector2(0,-35)
 g._unhandled_input(event)
 assert(g.mouse_npc==0)
 for i in range(100): g._process(0.02)
 assert(g.dialog_npc==0 and g.quest==0)
 g.choose_dialog(0)
 g.close_dialog()
 assert(g.quest==1 and g.level==2)
 assert(g.route.is_empty())
 g.navigate(Vector2(3450,1800))
 assert(g.route.size()==3,"Level one may leave through the gate")
 g.level=10
 g.navigate(Vector2(3450,1800))
 assert(g.route.size()==3,"Cross-zone path must use the gate")
 for i in range(600): g._process(0.02)
 assert(g.hero.x>2800)
 g.hero=g.enemies[0].pos+Vector2(80,0)
 event.position=g.screen_pos(g.enemies[0].pos)
 g._unhandled_input(event)
 assert(g.mouse_enemy==0)
 g._process(0.01)
 assert(g.enemies[0].hp<g.enemies[0].max and g.enemies[0].aggro)
 g.new_run()
 assert(g.mouse_enemy==-1 and g.mouse_npc==-1 and g.route.is_empty())
 var img:=Image.load_from_file("res://assets/knight_reused.png")
 assert(img.get_pixel(0,0).a==0,"Reused character must have real alpha")
 assert(img.get_pixel(380,380).a>0)
 g.free()
 print("PASS: iso inverse, mouse NPC approach/dialogue, gate routing, click attack, reset, character alpha")
 quit()
