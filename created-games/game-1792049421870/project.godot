config_version=5
[application]
config/name="真的在干了"
run/main_scene="res://main.tscn"
[autoload]
GameAssistant="*res://game_assistant.gd"
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
[gui]
theme/custom_font="res://font.ttf"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.macos="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/driver.macos="metal"
rendering_device/fallback_to_opengl3=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.028, 0.036, 0.042, 1)
