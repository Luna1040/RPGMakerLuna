config_version=5

[application]
config/name="月汐食堂 · Moontide Bistro"
run/main_scene="res://main.tscn"

[autoload]
GameAssistant="*res://game_assistant.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025,0.055,0.10,1)
