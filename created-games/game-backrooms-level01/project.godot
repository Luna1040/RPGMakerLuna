config_version=5

[application]
config/name="回声层：黄灯办公区"
run/main_scene="res://main.tscn"

[autoload]
GameAssistant="*res://game_assistant.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=800
window/size/window_height_override=450
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.04, 0.025, 1)

[gui]
theme/custom_font="res://font.ttf"
