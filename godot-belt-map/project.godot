config_version=5
[application]
config/name="Knight - 2.5D Courtyard"
run/main_scene="res://stage.tscn"
[autoload]
NpcAssetRegistry="*res://systems/content/npc_asset_registry.gd"
ContentRegistry="*res://systems/content/content_registry.gd"
ContentDraftService="*res://systems/content/content_draft_service.gd"
WorldBlueprintService="*res://systems/content/world_blueprint_service.gd"
CampaignImportService="*res://systems/content/campaign_import_service.gd"
CampaignSessionService="*res://systems/content/campaign_session_service.gd"
WorkbenchBridge="*res://systems/workbench_bridge.gd"
AuthoringOrchestrator="*res://systems/agent/authoring_orchestrator.gd"
AgentTransportService="*res://systems/agent/agent_transport_service.gd"
AuthoringPersistenceService="*res://systems/agent/authoring_persistence_service.gd"
GameSession="*res://systems/session_bridge.gd"
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.19,0.25,0.29,1)
