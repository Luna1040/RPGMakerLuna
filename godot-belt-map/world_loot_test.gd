extends SceneTree
const Loot = preload("world_loot.gd")
const Gear = preload("characters/first_knight/equipment.gd")
var failed := false
func verify(condition: bool, message: String) -> void:
	if not condition:
		failed=true
		push_error(message)
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var sorting := Node2D.new()
	root.add_child(sorting)
	var crate_node := Node2D.new()
	crate_node.name="test-crate"
	sorting.add_child(crate_node)
	var volumes: Array=[{"id":"test-crate","kind":"crate","x":4.0,"depth":4.0,"width":1.0,"depth_size":1.0,"base_z":0.0,"height":0.85,"solid":true,"standable":true}]
	var gear := Gear.new()
	gear.persistence_enabled=false
	var loot := Loot.new()
	root.add_child(loot)
	loot.setup(sorting,volumes,func(p: Vector2,z: float) -> Vector2: return Vector2(p.x*120,410+p.y*45-z*120),gear)
	var event := {"facing":1,"range":244,"damage":22}
	verify(loot.hit_melee(Vector2(2.5,7),0,event)==0,"Melee incorrectly crosses depth lanes")
	verify(loot.hit_melee(Vector2(2.5,4.5),1.8,event)==0,"High jump incorrectly hits crate")
	verify(loot.hit_melee(Vector2(2.5,4.5),0,{"facing":-1,"range":244,"damage":22})==0,"Backwards attack hits crate")
	verify(loot.hit_melee(Vector2(2.5,4.5),0,event)==1,"Valid melee misses")
	verify(volumes.size()==1,"First hit destroys full health crate")
	verify(not loot.hit_projectile(3,6,7,1.65,42),"Projectile crosses depth lanes")
	verify(not loot.hit_projectile(3,6,4.5,3,42),"High projectile hits low crate")
	verify(loot.hit_projectile(3,6,4.5,1.65,42),"Intended ground-level spell cannot damage crate")
	verify(volumes.is_empty() and loot.crates.is_empty(),"Destroyed crate retains collision/support")
	verify(loot.drops.size()==3,"Crate loot missing")
	loot._process(0.3)
	verify(not loot.interact(Vector2(4.5,4.7),1),"Airborne character picks ground loot")
	verify(loot.interact(Vector2(4.5,4.7),0),"Ground loot pickup failed")
	verify(loot.materials["木料"]==3 and loot.materials["旧铜币"]==5 and loot.drops.is_empty(),"Material quantities wrong")
	verify(not gear.owned.has("courtyard_blade"),"New chest loot owned initially")
	verify(loot.interact(Vector2(11.8,6.8),0),"Chest cannot open")
	verify(loot.drops.size()==2,"Chest drops missing")
	verify(not loot.interact(Vector2(11.8,6.8),0),"Opened chest spawns again")
	loot._process(0.3)
	verify(loot.interact(Vector2(11.8,7.25),0),"Chest loot pickup failed")
	verify(gear.owned.has("courtyard_blade") and gear.owned.has("courtyard_mail"),"Chest items absent from gear inventory")
	verify(gear.equipped.weapon=="knight_sword","Pickup unexpectedly autoequips")
	verify(loot.quick_equip(Vector2(11.8,7.25),0) and gear.equipped.armor=="courtyard_mail","Q did not equip most recent batch item")
	verify(loot.quick_equip(Vector2(11.8,7.25),0) and gear.equipped.weapon=="courtyard_blade" and gear.bonuses().attack==12,"Repeated Q loses weapon after batch armor pickup")
	verify(not loot.quick_equip(Vector2(11.8,7.25),0),"Repeated Q re-equips worn item")
	verify(not gear.grant("courtyard_blade"),"Duplicate ownership accepted")
	loot.spawn_drop("courtyard_blade",1,Vector2(11.8,7.25),true)
	loot._process(0.3)
	loot.interact(Vector2(11.8,7.25),0)
	verify(loot.materials["秘银碎屑"]==2,"Duplicate equipment compensation missing")
	var spot := Vector2(9,5)
	for id: String in ["courtyard_blade","courtyard_mail","courtyard_charm"]:
		var slot: String=gear.CATALOG[id].slot
		gear.unequip(slot)
		loot.spawn_drop(id,1,spot,true)
		verify(not loot.quick_equip(spot,0),"Q picks unready falling loot")
		loot._process(0.3)
		verify(not loot.quick_equip(spot+Vector2(2,0),0),"Q picks distant equipment")
		verify(not loot.quick_equip(spot+Vector2(0,0.7),0),"Q picks across depth lane")
		verify(not loot.quick_equip(spot,1),"Q picks ground equipment while airborne")
		verify(loot.prompt(spot,0).contains(str(gear.CATALOG[id].name)),"Ground equipment prompt omits name")
		verify(loot.quick_equip(spot,0) and gear.equipped[slot]==id,"Q fails direct ground equip: "+id)
		verify(loot.drops.is_empty(),"Q leaves equipped loot on ground")
		verify(loot.materials["秘银碎屑"]==2,"Owned but unworn gear was destroyed instead of equipped")
	# Nearest ground item wins, independent of drop insertion order.
	gear.unequip("weapon")
	gear.unequip("armor")
	loot.spawn_drop("courtyard_mail",1,spot+Vector2(0.5,0),true)
	loot.spawn_drop("courtyard_blade",1,spot,true)
	loot._process(0.3)
	verify(loot.quick_equip(spot,0) and gear.equipped.weapon=="courtyard_blade" and gear.equipped.armor=="","Q ignores nearest weapon")
	verify(loot.quick_equip(spot,0) and gear.equipped.armor=="courtyard_mail","Q fails next nearby armor")
	loot.spawn_drop("courtyard_blade",1,spot,true)
	loot._process(0.3)
	verify(loot.quick_equip(spot,0) and loot.materials["秘银碎屑"]==4 and loot.drops.is_empty(),"Q worn duplicate handling incorrect")
	print("WORLD_LOOT_TEST "+("FAIL" if failed else "PASS"))
	quit(1 if failed else 0)
