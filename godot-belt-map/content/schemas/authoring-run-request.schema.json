{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpgmakerluna:schema:authoring-run-request",
  "title": "Main Agent RPG Authoring Run Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "genre", "theme", "tone", "scope", "content_policy", "requested_systems", "constraints"],
  "properties": {
    "schema_version": {"const": "authoring-run-request/1"},
    "project_id": {"type": "string", "pattern": "^project\\.[a-z0-9][a-z0-9_.-]+$", "maxLength": 128},
    "genre": {"enum": ["western_fantasy", "cultivation", "wuxia", "hybrid"]},
    "theme": {"type": "string", "minLength": 1, "maxLength": 240},
    "tone": {"enum": ["heroic", "dark", "light", "mystery"]},
    "scope": {"enum": ["demo", "chapter", "campaign"]},
    "content_policy": {"enum": ["general", "mature_consensual"]},
    "requested_systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"enum": ["world", "map", "town", "npcs", "main_quest", "side_quests", "affinity", "items", "equipment", "shops"]}
    },
    "constraints": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    }
  }
}
