{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpgmakerluna:schema:content-bundle",
  "title": "RPG Content Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "content_type", "entries"],
  "properties": {
    "schema_version": {"const": "rpg-content-bundle/1"},
    "bundle_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "content_type": {"enum": ["skills", "equipment", "npcs"]},
    "entries": {"type": "array", "minItems": 1, "maxItems": 512}
  },
  "oneOf": [
    {"properties": {"content_type": {"const": "skills"}, "entries": {"items": {"$ref": "#/$defs/skill"}}}},
    {"properties": {"content_type": {"const": "equipment"}, "entries": {"items": {"$ref": "#/$defs/equipment"}}}},
    {"properties": {"content_type": {"const": "npcs"}, "entries": {"items": {"$ref": "#/$defs/npc"}}}}
  ],
  "$defs": {
    "registeredId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "simpleId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "display_name", "description", "action_profile_id", "resource_cost", "cooldown_seconds", "combat", "presentation"],
      "properties": {
        "id": {"type": "string", "pattern": "^skill\\.[a-z0-9_.-]+$"},
        "kind": {"const": "skill"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "action_profile_id": {"type": "string", "pattern": "^action\\.[a-z0-9_.-]+$"},
        "resource_cost": {"type": "object", "additionalProperties": false, "required": ["type", "amount"], "properties": {"type": {"enum": ["mp", "stamina", "none"]}, "amount": {"type": "number", "minimum": 0, "maximum": 999}}},
        "cooldown_seconds": {"type": "number", "minimum": 0, "maximum": 600},
        "combat": {"type": "object", "additionalProperties": false, "required": ["base_damage", "depth_radius", "chain_count", "chain_radius_m", "tags"], "properties": {
          "base_damage": {"type": "number", "minimum": 0, "maximum": 100000},
          "depth_radius": {"type": "number", "minimum": 0.05, "maximum": 3},
          "chain_count": {"type": "integer", "minimum": 1, "maximum": 8},
          "chain_radius_m": {"type": "number", "minimum": 0, "maximum": 12},
          "tags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
        }},
        "presentation": {"type": "object", "additionalProperties": false, "required": ["vfx_id", "sfx_id"], "properties": {"vfx_id": {"$ref": "#/$defs/registeredId"}, "sfx_id": {"$ref": "#/$defs/registeredId"}}}
      }
    },
    "equipment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "slot", "quality", "symbol", "description", "stats"],
      "properties": {
        "id": {"$ref": "#/$defs/simpleId"}, "kind": {"const": "equipment"},
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "slot": {"enum": ["weapon", "armor", "charm", "boots"]},
        "quality": {"type": "string", "minLength": 1, "maxLength": 32},
        "symbol": {"type": "string", "minLength": 1, "maxLength": 8},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "stats": {"type": "object", "additionalProperties": false, "maxProperties": 7, "properties": {
          "health": {"type": "number", "minimum": -10000, "maximum": 10000}, "mana": {"type": "number", "minimum": -10000, "maximum": 10000},
          "attack": {"type": "number", "minimum": -10000, "maximum": 10000}, "magic": {"type": "number", "minimum": -10000, "maximum": 10000},
          "defense": {"type": "number", "minimum": -10000, "maximum": 10000}, "speed": {"type": "number", "minimum": -10000, "maximum": 10000},
          "regen": {"type": "number", "minimum": -10000, "maximum": 10000}
        }}
      }
    },
    "npc": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "display_name", "position_m", "visual", "ambient_lines"],
      "properties": {
        "id": {"$ref": "#/$defs/simpleId"}, "kind": {"const": "npc"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "position_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -10000, "maximum": 10000}},
        "visual": {"type": "object", "additionalProperties": false, "required": ["base_asset_id", "idle_manifest_asset_id", "pivot_px", "drawn_height_px", "portrait_region_px"], "properties": {
          "profile_id": {"type": "string", "pattern": "^profile\\.npc\\.[a-z0-9_.-]+$"},
          "base_asset_id": {"type": "string", "pattern": "^asset\\.[a-z0-9_.-]+$"},
          "idle_manifest_asset_id": {"type": "string", "pattern": "^asset\\.[a-z0-9_.-]+$"},
          "ambient_action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 32},
          "pivot_px": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -10000, "maximum": 10000}},
          "drawn_height_px": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
          "portrait_region_px": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 10000}}
        }},
        "ambient_lines": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 400}}
      }
    }
  }
}
