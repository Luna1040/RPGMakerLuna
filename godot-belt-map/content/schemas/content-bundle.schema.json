{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpgmakerluna:schema:content-bundle",
  "title": "RPG Content Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "content_type", "entries"],
  "properties": {
    "schema_version": {"const": "rpg-content-bundle/1"},
    "bundle_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "content_type": {"const": "skills"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "registeredId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "display_name", "description", "action_profile_id", "resource_cost", "cooldown_seconds", "combat", "presentation"],
      "properties": {
        "id": {"type": "string", "pattern": "^skill\\.[a-z0-9_.-]+$"},
        "kind": {"const": "skill"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "action_profile_id": {"type": "string", "pattern": "^action\\.[a-z0-9_.-]+$"},
        "resource_cost": {
          "type": "object", "additionalProperties": false, "required": ["type", "amount"],
          "properties": {"type": {"enum": ["mp", "stamina", "none"]}, "amount": {"type": "number", "minimum": 0, "maximum": 999}}
        },
        "cooldown_seconds": {"type": "number", "minimum": 0, "maximum": 600},
        "combat": {
          "type": "object", "additionalProperties": false,
          "required": ["base_damage", "depth_radius", "chain_count", "chain_radius_m", "tags"],
          "properties": {
            "base_damage": {"type": "number", "minimum": 0, "maximum": 100000},
            "depth_radius": {"type": "number", "minimum": 0.05, "maximum": 3},
            "chain_count": {"type": "integer", "minimum": 1, "maximum": 8},
            "chain_radius_m": {"type": "number", "minimum": 0, "maximum": 12},
            "tags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
          }
        },
        "presentation": {
          "type": "object", "additionalProperties": false, "required": ["vfx_id", "sfx_id"],
          "properties": {"vfx_id": {"$ref": "#/$defs/registeredId"}, "sfx_id": {"$ref": "#/$defs/registeredId"}}
        }
      }
    }
  }
}
