{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpgmakerluna:schema:content-draft",
  "title": "Validated RPG Content Draft",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "draft_id", "project_id", "base_catalog_hash", "base_content_revision", "author_role", "summary", "operations"],
  "properties": {
    "schema_version": {"const": "content-draft/1"},
    "draft_id": {"type": "string", "pattern": "^draft\\.[a-z0-9][a-z0-9_.-]+$", "maxLength": 128},
    "project_id": {"type": "string", "pattern": "^project\\.[a-z0-9][a-z0-9_.-]+$", "maxLength": 128},
    "base_catalog_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_content_revision": {"type": "integer", "minimum": 0},
    "author_role": {"enum": ["main", "narrative", "npc", "systems"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "operations": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/operation"}},
    "world_bundle": {"type": "object"}
  },
  "$defs": {
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "target_type", "target_id", "definition"],
      "properties": {
        "op": {"const": "upsert"},
        "target_type": {"enum": ["quest", "dialogue", "npc", "equipment", "item", "shop"]},
        "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "definition": {"type": "object"}
      }
    }
  }
}
