{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpgmakerluna:schema:agent-transport-config",
  "title": "Agent Transport Safe Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "endpoint", "model", "timeout_seconds", "max_retries", "max_concurrency"],
  "properties": {
    "schema_version": {"const": "agent-transport-config/1"},
    "provider": {"const": "openai_compatible"},
    "profile_id": {"enum": ["custom", "openai", "local"], "default": "custom"},
    "endpoint": {"type": "string", "minLength": 12, "maxLength": 512},
    "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,127}$"},
    "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 120},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 3},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 4}
  }
}
