diff --git a/godot-belt-map/core/content/content_registry.gd b/godot-belt-map/core/content/content_registry.gd
new file mode 100644
index 0000000..9613b4c
--- /dev/null
+++ b/godot-belt-map/core/content/content_registry.gd
@@ -0,0 +1,82 @@
+extends Node
+## Read-only registry for validated, data-driven RPG definitions.
+
+signal content_reloaded(source_path: String, revision: int)
+signal content_rejected(source_path: String, errors: Array[String])
+
+const ContentValidator = preload("res://core/validation/content_validator.gd")
+const BASE_SKILLS_PATH := "res://content/base/skills.json"
+
+var revision := 0
+var loaded := false
+var last_errors: Array[String] = []
+var _content: Dictionary = {}
+
+func _ready() -> void:
+	if not reload_base_content():
+		push_error("ContentRegistry rejected base content: " + "; ".join(last_errors))
+
+func reload_base_content(path := BASE_SKILLS_PATH) -> bool:
+	last_errors.clear()
+	if not FileAccess.file_exists(path):
+		return _reject(path, ["Content bundle file does not exist."])
+	var parser := JSON.new()
+	var parse_error := parser.parse(FileAccess.get_file_as_string(path))
+	if parse_error != OK:
+		return _reject(path, ["Invalid JSON at line %d: %s" % [parser.get_error_line(), parser.get_error_message()]])
+	var errors := ContentValidator.validate_content_bundle(parser.data)
+	if not errors.is_empty():
+		return _reject(path, errors)
+	var bundle: Dictionary = parser.data
+	var content_type := str(bundle["content_type"])
+	var next_entries := {}
+	for entry in bundle["entries"]:
+		var definition: Dictionary = entry.duplicate(true)
+		definition["source_bundle_id"] = str(bundle["bundle_id"])
+		next_entries[str(definition["id"])] = definition
+	_content[content_type] = next_entries
+	revision += 1
+	loaded = true
+	content_reloaded.emit(path, revision)
+	return true
+
+func has_entry(content_type: String, content_id: String) -> bool:
+	return _content.has(content_type) and _content[content_type].has(content_id)
+
+func get_entry(content_type: String, content_id: String) -> Dictionary:
+	if not has_entry(content_type, content_id):
+		return {}
+	return _content[content_type][content_id].duplicate(true)
+
+func get_skill(skill_id: String) -> Dictionary:
+	return get_entry("skills", skill_id)
+
+func registered_ids(content_type: String) -> Array[String]:
+	var result: Array[String] = []
+	if _content.has(content_type):
+		for content_id in _content[content_type]:
+			result.append(str(content_id))
+	result.sort()
+	return result
+
+func snapshot() -> Dictionary:
+	return {
+		"schema_version": ContentValidator.CONTENT_BUNDLE_SCHEMA,
+		"revision": revision,
+		"content": _content.duplicate(true)
+	}
+
+func validate_runtime_patch(patch: Variant) -> Array[String]:
+	var errors := ContentValidator.validate_runtime_patch(patch)
+	if patch is Dictionary:
+		for operation in patch.get("operations", []):
+			if operation is Dictionary and operation.get("target_type") == "skill":
+				var target_id := str(operation.get("target_id", ""))
+				if not target_id.is_empty() and not has_entry("skills", target_id):
+					errors.append("Unknown patch target: " + target_id)
+	return errors
+
+func _reject(path: String, errors: Array[String]) -> bool:
+	last_errors.assign(errors)
+	content_rejected.emit(path, last_errors)
+	return false
