+        }
+      }
+    }
+  }
+}
diff --git a/godot-belt-map/content_foundation_test.gd b/godot-belt-map/content_foundation_test.gd
new file mode 100644
index 0000000..df7fd36
--- /dev/null
+++ b/godot-belt-map/content_foundation_test.gd
@@ -0,0 +1,68 @@
+extends SceneTree
+## B-01 contract test. This deliberately avoids loading art assets so it can run
+## even before Git LFS has hydrated the repository checkout.
+
+const ContentValidator = preload("res://core/validation/content_validator.gd")
+const Knight = preload("res://characters/first_knight/knight.gd")
+
+var failures: Array[String] = []
+
+func check(condition: bool, message: String) -> void:
+	if not condition:
+		failures.append(message)
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func run() -> void:
+	var registry := root.get_node_or_null("ContentRegistry")
+	var game_state := root.get_node_or_null("GameState")
+	var save_service := root.get_node_or_null("SaveService")
+	check(registry != null and registry.loaded, "ContentRegistry did not load base content")
+	check(game_state != null, "GameState autoload is missing")
+	check(save_service != null, "SaveService autoload is missing")
+	if registry != null:
+		var lightning: Dictionary = registry.get_skill("skill.knight.lightning")
+		check(lightning.get("display_name") == "雷光", "Lightning display name is not data-driven")
+		check(is_equal_approx(float(lightning.get("resource_cost", {}).get("amount", -1)), 25.0), "Lightning MP cost changed")
+		check(is_equal_approx(float(lightning.get("cooldown_seconds", -1)), 2.4), "Lightning cooldown changed")
+		check(is_equal_approx(float(lightning.get("combat", {}).get("base_damage", -1)), 42.0), "Lightning base damage changed")
+		var knight := Knight.new()
+		knight.content_registry_override = registry
+		check(is_equal_approx(knight.get_spell_mana_cost(), 25.0), "Knight does not consume registry MP cost")
+		check(is_equal_approx(knight.get_spell_cooldown(), 2.4), "Knight does not consume registry cooldown")
+		check(is_equal_approx(knight.get_spell_damage(), 42.0), "Knight does not consume registry damage")
+		knight.free()
+
+	var valid_patch := {
+		"schema_version": "runtime-patch/1",
+		"patch_id": "test.lightning.balance",
+		"base_state_version": 0,
+		"operations": [{
+			"op": "replace",
+			"target_type": "skill",
+			"target_id": "skill.knight.lightning",
+			"path": "/combat/base_damage",
+			"value": 43.0
+		}]
+	}
+	check(ContentValidator.validate_runtime_patch(valid_patch).is_empty(), "Valid runtime patch was rejected")
+	var unsafe_patch: Dictionary = valid_patch.duplicate(true)
+	unsafe_patch["operations"][0]["path"] = "/script"
+	check(not ContentValidator.validate_runtime_patch(unsafe_patch).is_empty(), "Unsafe script patch was accepted")
+
+	if game_state != null and save_service != null:
+		var original: Dictionary = game_state.export_snapshot()
+		check(game_state.set_section_value("flags", "b01_test", true, "contract_test"), "GameState update failed")
+		check(save_service.save_slot("b01_contract_test"), "SaveService failed: " + save_service.last_error)
+		check(save_service.save_slot("b01_contract_test"), "SaveService failed to replace an existing slot: " + save_service.last_error)
+		game_state.set_section_value("flags", "b01_test", false, "contract_test_mutation")
+		check(save_service.load_slot("b01_contract_test"), "SaveService load failed: " + save_service.last_error)
+		check(game_state.flags.get("b01_test") == true, "Loaded state did not restore the saved value")
+		game_state.restore_snapshot(original)
+		DirAccess.remove_absolute("user://saves/b01_contract_test.json")
+
+	for message in failures:
+		push_error(message)
+	print("CONTENT_FOUNDATION_TEST " + ("PASS" if failures.is_empty() else "FAIL"))
+	quit(0 if failures.is_empty() else 1)
