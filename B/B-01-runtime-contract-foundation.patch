diff --git a/godot-belt-map/core/validation/content_validator.gd b/godot-belt-map/core/validation/content_validator.gd
new file mode 100644
index 0000000..a1058d7
--- /dev/null
+++ b/godot-belt-map/core/validation/content_validator.gd
@@ -0,0 +1,172 @@
+extends RefCounted
+## Runtime validation for data generated by tools or AI agents.
+##
+## Godot never executes generated scripts from this boundary. Only registered
+## content types and an explicit patch-path allowlist are accepted.
+
+const CONTENT_BUNDLE_SCHEMA := "rpg-content-bundle/1"
+const RUNTIME_PATCH_SCHEMA := "runtime-patch/1"
+const SUPPORTED_CONTENT_TYPES := ["skills"]
+const PATCHABLE_SKILL_PATHS := {
+	"/resource_cost/amount": {"min": 0.0, "max": 999.0},
+	"/cooldown_seconds": {"min": 0.0, "max": 600.0},
+	"/combat/base_damage": {"min": 0.0, "max": 100000.0},
+	"/combat/depth_radius": {"min": 0.0, "max": 20.0}
+}
+
+static func validate_content_bundle(value: Variant) -> Array[String]:
+	var errors: Array[String] = []
+	if not value is Dictionary:
+		errors.append("Content bundle must be a JSON object.")
+		return errors
+	var bundle: Dictionary = value
+	_require_string(bundle, "schema_version", errors)
+	_require_string(bundle, "bundle_id", errors)
+	_require_string(bundle, "content_type", errors)
+	if bundle.get("schema_version") != CONTENT_BUNDLE_SCHEMA:
+		errors.append("Unsupported content bundle schema_version.")
+	var content_type := str(bundle.get("content_type", ""))
+	if not content_type in SUPPORTED_CONTENT_TYPES:
+		errors.append("Unsupported content_type: " + content_type)
+	var entries = bundle.get("entries")
+	if not entries is Array:
+		errors.append("entries must be an array.")
+		return errors
+	if entries.is_empty():
+		errors.append("entries must contain at least one item.")
+	if entries.size() > 512:
+		errors.append("entries exceeds the 512 item limit.")
+	var seen_ids := {}
+	for index in range(entries.size()):
+		var entry = entries[index]
+		if content_type == "skills":
+			errors.append_array(validate_skill(entry, "entries[%d]" % index))
+		if entry is Dictionary:
+			var entry_id := str(entry.get("id", ""))
+			if not entry_id.is_empty() and seen_ids.has(entry_id):
+				errors.append("Duplicate content id: " + entry_id)
+			seen_ids[entry_id] = true
+	return errors
+
+static func validate_skill(value: Variant, location := "skill") -> Array[String]:
+	var errors: Array[String] = []
+	if not value is Dictionary:
+		errors.append(location + " must be an object.")
+		return errors
+	var skill: Dictionary = value
+	_require_string(skill, "id", errors, location)
+	_require_string(skill, "kind", errors, location)
+	_require_string(skill, "display_name", errors, location)
+	_require_string(skill, "description", errors, location)
+	_require_string(skill, "action_profile_id", errors, location)
+	var skill_id := str(skill.get("id", ""))
+	if not _valid_registered_id(skill_id, "skill"):
+		errors.append(location + ".id must be a canonical skill id.")
+	if skill.get("kind") != "skill":
+		errors.append(location + ".kind must equal 'skill'.")
+	if str(skill.get("display_name", "")).length() > 64:
+		errors.append(location + ".display_name exceeds 64 characters.")
+	if str(skill.get("description", "")).length() > 240:
+		errors.append(location + ".description exceeds 240 characters.")
+	if not _valid_registered_id(str(skill.get("action_profile_id", "")), "action"):
+		errors.append(location + ".action_profile_id must be a canonical action id.")
+
+	var resource_cost = skill.get("resource_cost")
+	if not resource_cost is Dictionary:
+		errors.append(location + ".resource_cost must be an object.")
+	else:
+		var cost: Dictionary = resource_cost
+		if not cost.get("type") in ["mp", "stamina", "none"]:
+			errors.append(location + ".resource_cost.type is not supported.")
+		_validate_number(cost.get("amount"), 0.0, 999.0, location + ".resource_cost.amount", errors)
+	_validate_number(skill.get("cooldown_seconds"), 0.0, 600.0, location + ".cooldown_seconds", errors)
+
+	var combat = skill.get("combat")
+	if not combat is Dictionary:
+		errors.append(location + ".combat must be an object.")
+	else:
+		var combat_data: Dictionary = combat
+		_validate_number(combat_data.get("base_damage"), 0.0, 100000.0, location + ".combat.base_damage", errors)
+		_validate_number(combat_data.get("depth_radius"), 0.0, 20.0, location + ".combat.depth_radius", errors)
+		var tags = combat_data.get("tags")
+		if not tags is Array:
+			errors.append(location + ".combat.tags must be an array.")
+		elif tags.size() > 32:
+			errors.append(location + ".combat.tags exceeds 32 items.")
+		else:
+			for tag in tags:
+				if not tag is String or str(tag).is_empty():
+					errors.append(location + ".combat.tags contains an invalid tag.")
+
+	var presentation = skill.get("presentation")
+	if not presentation is Dictionary:
+		errors.append(location + ".presentation must be an object.")
+	else:
+		var presentation_data: Dictionary = presentation
+		if not _valid_registered_id(str(presentation_data.get("vfx_id", "")), "vfx"):
+			errors.append(location + ".presentation.vfx_id must be a canonical VFX id.")
+		if not _valid_registered_id(str(presentation_data.get("sfx_id", "")), "sfx"):
+			errors.append(location + ".presentation.sfx_id must be a canonical SFX id.")
+	return errors
+
+static func validate_runtime_patch(value: Variant) -> Array[String]:
+	var errors: Array[String] = []
+	if not value is Dictionary:
+		errors.append("Runtime patch must be a JSON object.")
+		return errors
+	var patch: Dictionary = value
+	if patch.get("schema_version") != RUNTIME_PATCH_SCHEMA:
+		errors.append("Unsupported runtime patch schema_version.")
+	_require_string(patch, "patch_id", errors)
+	_validate_integer(patch.get("base_state_version"), 0, 2147483647, "base_state_version", errors)
+	var operations = patch.get("operations")
+	if not operations is Array:
+		errors.append("operations must be an array.")
+		return errors
+	if operations.is_empty() or operations.size() > 64:
+		errors.append("operations must contain between 1 and 64 items.")
+	for index in range(operations.size()):
+		var location := "operations[%d]" % index
+		var operation = operations[index]
+		if not operation is Dictionary:
+			errors.append(location + " must be an object.")
+			continue
+		var op: Dictionary = operation
+		if op.get("op") != "replace":
+			errors.append(location + ".op must equal 'replace'.")
+		if op.get("target_type") != "skill":
+			errors.append(location + ".target_type must equal 'skill'.")
+		if not op.get("target_id") is String or not _valid_registered_id(str(op.get("target_id")), "skill"):
+			errors.append(location + ".target_id must be a skill id.")
+		var path := str(op.get("path", ""))
+		if not PATCHABLE_SKILL_PATHS.has(path):
+			errors.append(location + ".path is not patchable: " + path)
+			continue
+		var limits: Dictionary = PATCHABLE_SKILL_PATHS[path]
+		_validate_number(op.get("value"), float(limits["min"]), float(limits["max"]), location + ".value", errors)
+	return errors
+
+static func _require_string(value: Dictionary, key: String, errors: Array[String], prefix := "") -> void:
+	var location := key if prefix.is_empty() else prefix + "." + key
+	if not value.get(key) is String or str(value.get(key)).strip_edges().is_empty():
+		errors.append(location + " must be a non-empty string.")
+
+static func _validate_number(value: Variant, minimum: float, maximum: float, location: String, errors: Array[String]) -> void:
+	if not (value is int or value is float):
+		errors.append(location + " must be a number.")
+		return
+	var number := float(value)
+	if is_nan(number) or is_inf(number) or number < minimum or number > maximum:
+		errors.append("%s must be between %s and %s." % [location, minimum, maximum])
+
+static func _validate_integer(value: Variant, minimum: int, maximum: int, location: String, errors: Array[String]) -> void:
+	if not (value is int or value is float) or not is_equal_approx(float(value), roundf(float(value))) or int(value) < minimum or int(value) > maximum:
+		errors.append("%s must be an integer between %d and %d." % [location, minimum, maximum])
+
+static func _valid_registered_id(value: String, id_namespace: String) -> bool:
+	if value.length() > 128:
+		return false
+	var expression := RegEx.new()
+	if expression.compile("^" + id_namespace + "\\.[a-z0-9][a-z0-9_.-]+$") != OK:
+		return false
+	return expression.search(value) != null
