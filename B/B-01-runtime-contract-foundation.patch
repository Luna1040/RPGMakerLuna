diff --git a/godot-belt-map/core/save/save_service.gd b/godot-belt-map/core/save/save_service.gd
new file mode 100644
index 0000000..dcf727d
--- /dev/null
+++ b/godot-belt-map/core/save/save_service.gd
@@ -0,0 +1,118 @@
+extends Node
+## Versioned JSON saves with write-then-validate-then-rename semantics.
+
+signal save_completed(slot_id: String, path: String)
+signal load_completed(slot_id: String, state_version: int)
+signal persistence_error(operation: String, message: String)
+
+const SAVE_FORMAT := "rpg-save/1"
+const SAVE_DIRECTORY := "user://saves"
+
+var last_error := ""
+
+func has_slot(slot_id: String) -> bool:
+	return _valid_slot_id(slot_id) and FileAccess.file_exists(_slot_path(slot_id))
+
+func save_slot(slot_id := "autosave") -> bool:
+	last_error = ""
+	if not _valid_slot_id(slot_id):
+		return _fail("save", "Invalid save slot id.")
+	var game_state := get_node_or_null("/root/GameState")
+	if game_state == null:
+		return _fail("save", "GameState autoload is unavailable.")
+	var snapshot: Dictionary = game_state.export_snapshot()
+	var state_errors: Array[String] = game_state.validate_snapshot(snapshot)
+	if not state_errors.is_empty():
+		return _fail("save", "Game state validation failed: " + "; ".join(state_errors))
+	if not _ensure_save_directory():
+		return false
+	var envelope := {
+		"format": SAVE_FORMAT,
+		"saved_at_unix": int(Time.get_unix_time_from_system()),
+		"state": snapshot
+	}
+	var path := _slot_path(slot_id)
+	if not _write_json_atomic(path, envelope):
+		return false
+	save_completed.emit(slot_id, path)
+	return true
+
+func read_slot(slot_id := "autosave") -> Dictionary:
+	last_error = ""
+	if not _valid_slot_id(slot_id):
+		_fail("load", "Invalid save slot id.")
+		return {}
+	var path := _slot_path(slot_id)
+	if not FileAccess.file_exists(path):
+		_fail("load", "Save slot does not exist.")
+		return {}
+	var parser := JSON.new()
+	if parser.parse(FileAccess.get_file_as_string(path)) != OK:
+		_fail("load", "Save JSON is invalid: " + parser.get_error_message())
+		return {}
+	if not parser.data is Dictionary or parser.data.get("format") != SAVE_FORMAT or not parser.data.get("state") is Dictionary:
+		_fail("load", "Save envelope is invalid or unsupported.")
+		return {}
+	return parser.data.duplicate(true)
+
+func load_slot(slot_id := "autosave") -> bool:
+	var envelope := read_slot(slot_id)
+	if envelope.is_empty():
+		return false
+	var game_state := get_node_or_null("/root/GameState")
+	if game_state == null:
+		return _fail("load", "GameState autoload is unavailable.")
+	if not game_state.restore_snapshot(envelope["state"]):
+		return _fail("load", "Saved game state failed validation.")
+	load_completed.emit(slot_id, game_state.state_version)
+	return true
+
+func _write_json_atomic(path: String, data: Dictionary) -> bool:
+	var temporary_path := path + ".tmp"
+	var backup_path := path + ".bak"
+	var file := FileAccess.open(temporary_path, FileAccess.WRITE)
+	if file == null:
+		return _fail("save", "Unable to open temporary save file.")
+	file.store_string(JSON.stringify(data, "\t"))
+	file.flush()
+	var write_error := file.get_error()
+	file.close()
+	if write_error != OK:
+		return _fail("save", "Unable to flush temporary save file.")
+	var verifier := JSON.new()
+	if verifier.parse(FileAccess.get_file_as_string(temporary_path)) != OK or not verifier.data is Dictionary:
+		return _fail("save", "Temporary save failed read-back validation.")
+	if FileAccess.file_exists(backup_path):
+		DirAccess.remove_absolute(backup_path)
+	var had_previous := FileAccess.file_exists(path)
+	if had_previous and DirAccess.rename_absolute(path, backup_path) != OK:
+		return _fail("save", "Unable to preserve the previous save slot.")
+	if DirAccess.rename_absolute(temporary_path, path) != OK:
+		if had_previous:
+			DirAccess.rename_absolute(backup_path, path)
+		return _fail("save", "Unable to replace the save slot atomically.")
+	if had_previous:
+		DirAccess.remove_absolute(backup_path)
+	return true
+
+func _ensure_save_directory() -> bool:
+	var user_directory := DirAccess.open("user://")
+	if user_directory == null:
+		return _fail("save", "Unable to access user storage.")
+	if not user_directory.dir_exists("saves") and user_directory.make_dir("saves") != OK:
+		return _fail("save", "Unable to create the save directory.")
+	return true
+
+func _valid_slot_id(slot_id: String) -> bool:
+	var expression := RegEx.new()
+	if expression.compile("^[A-Za-z0-9_-]{1,40}$") != OK:
+		return false
+	return expression.search(slot_id) != null
+
+func _slot_path(slot_id: String) -> String:
+	return SAVE_DIRECTORY + "/" + slot_id + ".json"
+
+func _fail(operation: String, message: String) -> bool:
+	last_error = message
+	persistence_error.emit(operation, message)
+	return false
