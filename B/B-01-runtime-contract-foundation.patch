+extends Node
+## Authoritative serializable state. Runtime scenes can be migrated into this
+## store incrementally without changing current gameplay behavior.
+
+signal state_changed(state_version: int, reason: String)
+signal state_restored(state_version: int)
+
+const SCHEMA_VERSION := "game-state/1"
+
+var state_version := 0
+var campaign_id := "campaign.courtyard"
+var active_scene_id := "scene.courtyard"
+var player: Dictionary = {}
+var quests: Dictionary = {}
+var npcs: Dictionary = {}
+var world: Dictionary = {}
+var flags: Dictionary = {}
+
+func _ready() -> void:
+	reset()
+
+func reset(next_campaign_id := "campaign.courtyard") -> void:
+	state_version = 0
+	campaign_id = next_campaign_id
+	active_scene_id = "scene.courtyard"
+	player = {}
+	quests = {}
+	npcs = {}
+	world = {}
+	flags = {}
+
+func set_section_value(section: String, key: String, value: Variant, reason := "runtime_update") -> bool:
+	var target: Variant = _section(section)
+	if target == null or key.is_empty() or not _is_json_safe(value):
+		return false
+	target[key] = value
+	state_version += 1
+	state_changed.emit(state_version, reason)
+	return true
+
+func erase_section_value(section: String, key: String, reason := "runtime_update") -> bool:
+	var target: Variant = _section(section)
+	if target == null or not target.has(key):
+		return false
+	target.erase(key)
+	state_version += 1
+	state_changed.emit(state_version, reason)
+	return true
+
+func export_snapshot() -> Dictionary:
+	return {
+		"schema_version": SCHEMA_VERSION,
+		"state_version": state_version,
+		"campaign_id": campaign_id,
+		"active_scene_id": active_scene_id,
+		"player": player.duplicate(true),
+		"quests": quests.duplicate(true),
+		"npcs": npcs.duplicate(true),
+		"world": world.duplicate(true),
+		"flags": flags.duplicate(true)
+	}
+
+func validate_snapshot(value: Variant) -> Array[String]:
+	var errors: Array[String] = []
+	if not value is Dictionary:
+		errors.append("Game state must be an object.")
+		return errors
+	var snapshot: Dictionary = value
+	if snapshot.get("schema_version") != SCHEMA_VERSION:
+		errors.append("Unsupported game-state schema_version.")
+	var snapshot_version = snapshot.get("state_version")
+	if not (snapshot_version is int or snapshot_version is float) or not is_equal_approx(float(snapshot_version), roundf(float(snapshot_version))) or int(snapshot_version) < 0:
+		errors.append("state_version must be a non-negative integer.")
+	for key in ["campaign_id", "active_scene_id"]:
+		if not snapshot.get(key) is String or str(snapshot.get(key)).is_empty():
+			errors.append(key + " must be a non-empty string.")
+	for key in ["player", "quests", "npcs", "world", "flags"]:
+		if not snapshot.get(key) is Dictionary:
+			errors.append(key + " must be an object.")
+		elif not _is_json_safe(snapshot.get(key)):
+			errors.append(key + " contains a value that cannot be serialized safely.")
+	return errors
+
+func restore_snapshot(value: Variant) -> bool:
+	var errors := validate_snapshot(value)
+	if not errors.is_empty():
+		push_error("GameState rejected snapshot: " + "; ".join(errors))
+		return false
+	var snapshot: Dictionary = value
+	state_version = int(snapshot["state_version"])
+	campaign_id = str(snapshot["campaign_id"])
+	active_scene_id = str(snapshot["active_scene_id"])
+	player = snapshot["player"].duplicate(true)
+	quests = snapshot["quests"].duplicate(true)
+	npcs = snapshot["npcs"].duplicate(true)
+	world = snapshot["world"].duplicate(true)
+	flags = snapshot["flags"].duplicate(true)
+	state_restored.emit(state_version)
+	return true
+
+func _section(section: String) -> Variant:
+	match section:
+		"player": return player
+		"quests": return quests
+		"npcs": return npcs
+		"world": return world
+		"flags": return flags
+	return null
+
+func _is_json_safe(value: Variant, depth := 0) -> bool:
+	if depth > 16:
+		return false
+	match typeof(value):
+		TYPE_NIL, TYPE_BOOL, TYPE_INT, TYPE_STRING:
+			return true
+		TYPE_FLOAT:
+			return not is_nan(float(value)) and not is_inf(float(value))
+		TYPE_ARRAY:
+			for item in value:
+				if not _is_json_safe(item, depth + 1):
+					return false
+			return true
+		TYPE_DICTIONARY:
+			for key in value:
+				if not key is String or not _is_json_safe(value[key], depth + 1):
+					return false
+			return true
+	return false
